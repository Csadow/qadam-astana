{
  "name": "qadam-astana",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "ArcSolo's evidence-first Astana walking assistant",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "collect": "python3 scripts/collect_pois.py --map",
    "build": "node scripts/build.mjs",
    "evaluate": "node scripts/evaluate.mjs"
  }
}
